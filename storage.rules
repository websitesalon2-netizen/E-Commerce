rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for storefront assets: product images, branding, payment QR, banners
    match /{allPaths=**} {
      allow read: if true;
      // Write access restricted to authenticated manager/developer with 2MB file limit and image format validation
      allow write: if request.auth != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
