rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isManagerOrDev() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products: Public can read active products. Managers can create/update/delete.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isManagerOrDev();
    }

    // Categories: Public can read. Managers can manage.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isManagerOrDev();
    }

    // Settings (site, payment, delivery, contact, theme, businessHours): Public can read. Managers/Developers can write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isManagerOrDev();
    }

    // Orders:
    // - Guests can create orders with validated structure
    // - Individual orders can be read by order ID (for confirmation page) or by manager
    // - Only managers can update order status or delete
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['orderNumber', 'customerName', 'mobile', 'address', 'pinCode', 'items', 'grandTotal'])
        && request.resource.data.customerName is string
        && request.resource.data.mobile is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.grandTotal is number;

      allow get: if true;
      allow list: if isManagerOrDev();
      allow update, delete: if isManagerOrDev();
    }
  }
}
